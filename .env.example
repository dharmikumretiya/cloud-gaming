DATABASE_URL=file:./prisma/dev.db
# Website binding: loopback or this machine's private LAN IPv4 address.
BIND_ADDRESS=127.0.0.1
PORT=3001
SITE_ORIGIN=http://127.0.0.1:3001
HOST_ADDRESS=127.0.0.1
# Selkies is supervised by the backend and always binds to loopback.
# Consecutive loopback ports, one private Selkies display per gaming slot.
SELKIES_PORT=8082
# 1–4 separate games at once; tune to available GPU/CPU/RAM.
MAX_SESSIONS=2
# Match the host Mesa/AMD driver ABI instead of the AppImage's bundled libdrm.
SELKIES_HOST_DRM=true
# For another device, use trusted HTTPS. Paths resolve from backend/.
# npm run tls:generate creates local demo files without changing system trust.
# TLS_CERT_PATH=../.runtime/tls/cert.pem
# TLS_KEY_PATH=../.runtime/tls/key.pem
# SITE_ORIGIN=https://192.168.1.50:3001
# Development: SITE_ORIGIN=http://127.0.0.1:5173; leave TLS variables unset.
