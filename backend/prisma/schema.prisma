generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Game {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  imageUrl    String?
  launchId    String
  enabled     Boolean   @default(true)
  sessions    Session[]
}

model Session {
  id        Int       @id @default(autoincrement())
  gameId    Int
  ownerId   String?
  slot      Int?
  game      Game      @relation(fields: [gameId], references: [id])
  status    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
}
