{
  "name": "cloud-gaming",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "build": "npm run build -w frontend",
    "start": "npm run start -w backend",
    "tls:generate": "node scripts/generate-tls.js",
    "db:setup": "npm run db:generate -w backend && npm run db:migrate -w backend && npm run db:seed -w backend",
    "test": "npm run test -w backend",
    "stream:install": "node scripts/install-selkies.js",
    "games:install": "node scripts/install-games.js"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
